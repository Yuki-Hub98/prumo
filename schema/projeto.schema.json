      },
      "required": [
        "id",
        "tipo",
        "inicio",
        "fim",
        "largura",
        "altura"
      ],
      "title": "Viga",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raiz do ``projeto.json``.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "projeto": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Projeto",
      "type": "string"
    },
    "imovel": {
      "$ref": "#/$defs/Imovel"
    },
    "pavimentos": {
      "items": {
        "$ref": "#/$defs/Pavimento"
      },
      "minItems": 1,
      "title": "Pavimentos",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "projeto",
    "imovel",
    "pavimentos"
  ],
  "title": "Projeto",
  "type": "object"
