        "caminho": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Caminho",
          "type": "array"
        },
        "altura": {
          "$ref": "#/$defs/Medida"
        },
        "embutido": {
          "default": true,
          "title": "Embutido",
          "type": "boolean"
        },
        "obs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obs"
        }
      },
      "required": [
        "id",
        "forma",
        "tipo",
        "caminho",
        "altura"
      ],
      "title": "TrechoInstalacao",
      "type": "object"
    },
