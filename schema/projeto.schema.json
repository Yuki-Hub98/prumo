        "agua_fria",
        "agua_quente",
        "esgoto",
        "ralo",
        "gas"
      ],
      "title": "TipoInstalacao",
      "type": "string"
    },
    "TrechoInstalacao": {
      "additionalProperties": false,
      "description": "Trecho de tubulação/eletroduto. Se embutido, gera faixa de \"não furar\".",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "forma": {
          "const": "trecho",
          "title": "Forma",
