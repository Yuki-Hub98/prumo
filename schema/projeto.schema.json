            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Inicio",
          "type": "array"
        },
        "fim": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Fim",
          "type": "array"
        },
        "largura": {
          "$ref": "#/$defs/Medida"
        },
        "altura": {
          "$ref": "#/$defs/Medida",
