{
  "$defs": {
    "Chapa": {
      "additionalProperties": false,
      "description": "Material de chapa (MDF, MDP, HDF...) e sua espessura.",
      "properties": {
        "material": {
          "description": "Ex.: \"MDF branco\", \"MDP carvalho\", \"HDF branco\".",
          "title": "Material",
          "type": "string"
        },
        "espessura": {
          "$ref": "#/$defs/Medida"
        }
      },
      "required": [
        "material",
        "espessura"
      ],
      "title": "Chapa",
      "type": "object"
    },
    "Construcao": {
      "additionalProperties": false,
      "description": "Como o móvel planejado é construído por dentro (marcenaria em chapa).\n\nCaixa com laterais inteiras, base e tampo entre as laterais, divisórias entre a\nbase e o tampo, fundo sobreposto, portas sobrepostas (de abrir, por vão) ou de\ncorrer (no móvel todo, conforme ``Movel.portas``) e gavetas com corrediça\ntelescópica.",
      "properties": {
        "chapa": {
          "$ref": "#/$defs/Chapa"
        },
        "fundo": {
          "$ref": "#/$defs/Chapa"
        },
        "rodape": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Altura do rodapé (base recuada)."
        },
        "vaos": {
          "description": "Da esquerda para a direita (de frente).",
          "items": {
            "$ref": "#/$defs/Vao"
          },
          "minItems": 1,
          "title": "Vaos",
          "type": "array"
        }
      },
      "required": [
        "chapa",
        "fundo",
        "vaos"
      ],
      "title": "Construcao",
      "type": "object"
    },
    "Espaco": {
      "additionalProperties": false,
      "description": "Espaço dentro de um vão, de baixo para cima.\n\nEntre dois espaços seguidos entra uma prateleira, exceto entre duas gavetas\n(que ficam empilhadas). ``altura`` é a altura livre do espaço (na gaveta, a\naltura da frente); se faltar, divide igualmente o que sobra no vão.",
      "properties": {
        "tipo": {
          "enum": [
            "gaveta",
            "nicho",
            "cabideiro"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "altura": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "tipo"
      ],
      "title": "Espaco",
      "type": "object"
    },
    "Medida": {
      "additionalProperties": false,
      "description": "Medida em milímetros inteiros, sempre com origem.\n\nExemplo: ``{\"valor\": 3150, \"origem\": \"trena\", \"obs\": \"rodapé a rodapé\"}``.\nValores com casa decimal são recusados (unidade interna é mm inteiro).",
      "properties": {
        "valor": {
          "description": "Valor inteiro em milímetros.",
          "minimum": 0,
          "title": "Valor",
          "type": "integer"
        },
        "origem": {
          "$ref": "#/$defs/Origem"
        },
        "obs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Obs"
        },
        "data": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        }
      },
      "required": [
        "valor",
        "origem"
      ],
      "title": "Medida",
      "type": "object"
    },
    "Movel": {
      "additionalProperties": false,
      "description": "Móvel posicionado pelo centro, com rotação em graus (sentido anti-horário).\n\nConvenção de orientação: com ``rotacao: 0`` o móvel tem as **costas para -y**\n(para baixo na planta) e a **frente para +y**. A largura corre em x e a\nprofundidade em y. A rotação gira o móvel em torno do centro, então a frente\naponta para: 0 → +y, 90 → -x, 180 → -y, 270 → +x.\n\n\"Costas\" é o lado que encosta na parede: cabeceira da cama, fundo do\nguarda-roupa. \"Frente\" é o lado de uso: pés da cama, portas do guarda-roupa.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "tipo": {
          "description": "Tipo do catálogo (cama, guarda_roupa, sofa, tv...); fora dele vira caixa.",
          "title": "Tipo",
          "type": "string"
        },
        "modelo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Modelo do catálogo de onde vieram as medidas.",
          "title": "Modelo"
        },
        "nome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nome"
        },
        "centro": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Centro",
          "type": "array"
        },
        "rotacao": {
          "default": 0,
          "description": "Graus, anti-horário. Em 0 as costas ficam para -y e a frente para +y; a frente aponta para 0: +y, 90: -x, 180: -y, 270: +x.",
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotacao",
          "type": "integer"
        },
        "largura": {
          "$ref": "#/$defs/Medida",
          "description": "Dimensão ao longo do eixo x antes da rotação."
        },
        "profundidade": {
          "$ref": "#/$defs/Medida",
          "description": "Dimensão de costas a frente (eixo y antes da rotação)."
        },
        "altura": {
          "$ref": "#/$defs/Medida"
        },
        "portas": {
          "anyOf": [
            {
              "enum": [
                "abrir",
                "correr"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Portas na frente do móvel (guarda-roupa, armário). Define o espaço livre exigido à frente: de abrir precisa de mais.",
          "title": "Portas"
        },
        "largura_porta": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Largura de cada folha de porta de abrir (para o espaço de giro)."
        },
        "acabamento": {
          "anyOf": [
            {
              "enum": [
                "madeira_clara",
                "madeira_escura",
                "amadeirado",
                "branco_fosco",
                "laca_brilho",
                "preto_fosco"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Material da caixa (só visual); sem valor = o padrão do tipo.",
          "title": "Acabamento"
        },
        "puxador": {
          "anyOf": [
            {
              "enum": [
                "barra",
                "botao",
                "perfil",
                "cava"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tipo de puxador das portas e gavetas (só visual); sem valor = barra.",
          "title": "Puxador"
        },
        "pes": {
          "anyOf": [
            {
              "enum": [
                "quadrado",
                "palito",
                "metalico",
                "rodape"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tipo de pé (só visual); sem valor = o padrão do tipo.",
          "title": "Pes"
        },
        "elevacao": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Do piso até a base do móvel (TV na parede, armário aéreo). Móvel elevado não ocupa o piso: não conta para passagem nem para o giro de portas."
        },
        "polegadas": {
          "anyOf": [
            {
              "maximum": 150,
              "minimum": 10,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Diagonal da tela (TV).",
          "title": "Polegadas"
        },
        "construcao": {
          "anyOf": [
            {
              "$ref": "#/$defs/Construcao"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Móvel planejado: estrutura interna para desenho e lista de corte."
        },
        "forma": {
          "anyOf": [
            {
              "enum": [
                "arredondado",
                "redondo",
                "L"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Forma vista de cima (vazio = retangular): cantos arredondados (``raio``), redondo ou oval (círculo se largura = profundidade) ou em L (``braco``, ``lado_l``). Largura e profundidade continuam sendo a caixa em volta.",
          "title": "Forma"
        },
        "raio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raio dos cantos (forma arredondado)."
        },
        "braco": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Largura dos braços do L (forma L): a faixa das costas e a do lado."
        },
        "lado_l": {
          "anyOf": [
            {
              "enum": [
                "esquerda",
                "direita"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lado do braço que vem para a frente, olhando de frente (padrão: esquerda).",
          "title": "Lado L"
        }
      },
      "required": [
        "id",
        "tipo",
        "centro",
        "largura",
        "profundidade",
        "altura"
      ],
      "title": "Movel",
      "type": "object"
    },
    "Origem": {
      "description": "De onde veio a medida.",
      "enum": [
        "trena",
        "estimada",
        "projeto"
      ],
      "title": "Origem",
      "type": "string"
    },
    "Vao": {
      "additionalProperties": false,
      "description": "Coluna do móvel entre duas divisórias (ou entre a lateral e uma divisória).",
      "properties": {
        "largura": {
          "anyOf": [
            {
              "$ref": "#/$defs/Medida"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Largura livre; se faltar, divide igualmente o que sobra."
        },
        "espacos": {
          "description": "De baixo para cima.",
          "items": {
            "$ref": "#/$defs/Espaco"
          },
          "minItems": 1,
          "title": "Espacos",
          "type": "array"
        },
        "porta": {
          "default": true,
          "description": "Com portas de abrir: se este vão tem porta (False = nicho aberto).",
          "title": "Porta",
          "type": "boolean"
        }
      },
      "required": [
        "espacos"
      ],
      "title": "Vao",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raiz de ``comodos/<comodo>.json``: mobiliário e dados específicos.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "comodo": {
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Comodo",
      "type": "string"
    },
    "moveis": {
      "items": {
        "$ref": "#/$defs/Movel"
      },
      "title": "Moveis",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "comodo"
  ],
  "title": "DadosComodo",
  "type": "object"
}
