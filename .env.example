# Copie para .env e ajuste. Nunca commitar o .env.

# ---------------------------------------------------------------- portas no host
# Porta da SUA máquina onde cada serviço fica exposto. Troque se já estiver em uso
# (ex.: outro Postgres na 5432). As portas internas dos containers não mudam.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------- PostgreSQL (fonte da verdade)
# A CLI e a API montam a URL com estas variáveis; POSTGRES_HOST=db dentro do compose.
# Ou defina INTERIORES_BANCO_URL=postgresql+psycopg://usuario:senha@host:porta/banco
POSTGRES_HOST=localhost
POSTGRES_USER=interiores
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=interiores

# ---------------------------------------------------------------- MinIO
MINIO_ROOT_USER=interiores
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
MINIO_BUCKET=interiores

# ---------------------------------------------------------------- API (FastAPI)
API_PORT=8010                       # 8000 costuma estar ocupada
API_HOST=127.0.0.1                  # 0.0.0.0 dentro do Docker
API_CORS_ORIGENS=http://localhost:5173   # frontend (Vite); separe por vírgula
INTERIORES_API_EXPORTAR=1           # reexporta projetos/<p>/ a cada edição (0 = só banco)

# Wiki.js (documentação): http://localhost:${WIKI_PORT}
WIKI_PORT=3000
